{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dl-checkpoint-recovery-observation/v1",
  "title": "Deep-learning real-framework checkpoint recovery observation v1",
  "description": "Successful, hash-bound observation of one bounded PyTorch CUDA fixture checkpointed and resumed across fresh processes, with an uninterrupted control. This is single-host synthetic engineering evidence only; it is not real-data, remote-store, scheduler-service, cross-GPU, scientific, production, or adoption evidence.",
  "type": "object",
  "required": [
    "schema",
    "observation_id",
    "manifest_sha256",
    "run_id",
    "study_id",
    "case_sha256",
    "observed_at",
    "evidence_scope",
    "status",
    "runner",
    "fixture",
    "execution",
    "processes",
    "checkpoint",
    "equivalence",
    "budget_ledger",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "dl-checkpoint-recovery-observation/v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "case_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "x-rfc3339-datetime": true
    },
    "evidence_scope": {
      "const": "real_framework_hardware_checkpoint_recovery_engineering"
    },
    "status": {
      "const": "completed"
    },
    "runner": {
      "type": "object",
      "required": [
        "name",
        "version",
        "source_sha256"
      ],
      "properties": {
        "name": {
          "const": "pytorch-gpu-checkpoint-recovery-runner"
        },
        "version": {
          "const": "0.1.0"
        },
        "source_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "fixture_sha256",
        "seed",
        "samples",
        "requested_steps",
        "checkpoint_step"
      ],
      "properties": {
        "fixture_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": "integer"
        },
        "samples": {
          "type": "integer"
        },
        "requested_steps": {
          "type": "integer"
        },
        "checkpoint_step": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "os",
        "architecture",
        "python_version",
        "framework",
        "hardware"
      ],
      "properties": {
        "mode": {
          "const": "gpu_fixture"
        },
        "os": {
          "enum": [
            "windows",
            "linux"
          ]
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S+$"
        },
        "python_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?([+.-][0-9A-Za-z.-]+)?$"
        },
        "framework": {
          "type": "object",
          "required": [
            "name",
            "version",
            "backend",
            "backend_version",
            "determinism"
          ],
          "properties": {
            "name": {
              "const": "pytorch"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            },
            "backend": {
              "const": "cuda"
            },
            "backend_version": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            },
            "determinism": {
              "const": "strict"
            }
          },
          "additionalProperties": false
        },
        "hardware": {
          "type": "object",
          "required": [
            "device_model",
            "device_count",
            "memory_bytes_per_device",
            "compute_capability"
          ],
          "properties": {
            "device_model": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "device_count": {
              "type": "integer"
            },
            "memory_bytes_per_device": {
              "type": "integer"
            },
            "compute_capability": {
              "type": "string",
              "minLength": 3,
              "pattern": "^[0-9]+\\.[0-9]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "processes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "role",
          "completed_steps",
          "duration_seconds",
          "peak_memory_bytes"
        ],
        "properties": {
          "role": {
            "enum": [
              "source",
              "resume",
              "uninterrupted_control"
            ]
          },
          "completed_steps": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": "number"
          },
          "peak_memory_bytes": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "locator",
        "content_sha256",
        "size_bytes",
        "model_state_sha256",
        "optimizer_state_sha256",
        "scheduler_state_sha256",
        "completed_steps",
        "store_kind",
        "repository_persisted"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "^artifact://\\S+$"
        },
        "content_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer"
        },
        "model_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "optimizer_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "scheduler_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "completed_steps": {
          "type": "integer"
        },
        "store_kind": {
          "const": "caller_managed_local_directory"
        },
        "repository_persisted": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "equivalence": {
      "type": "object",
      "required": [
        "resumed_model_state_sha256",
        "control_model_state_sha256",
        "model_state_exact",
        "resumed_optimizer_state_sha256",
        "control_optimizer_state_sha256",
        "optimizer_state_exact",
        "resumed_scheduler_state_sha256",
        "control_scheduler_state_sha256",
        "scheduler_state_exact",
        "resumed_final_loss",
        "control_final_loss",
        "loss_absolute_delta"
      ],
      "properties": {
        "resumed_model_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_model_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_state_exact": {
          "const": true
        },
        "resumed_optimizer_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_optimizer_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "optimizer_state_exact": {
          "const": true
        },
        "resumed_scheduler_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_scheduler_state_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "scheduler_state_exact": {
          "const": true
        },
        "resumed_final_loss": {
          "type": "number"
        },
        "control_final_loss": {
          "type": "number"
        },
        "loss_absolute_delta": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "budget_ledger": {
      "type": "object",
      "required": [
        "declared_steps",
        "source_steps",
        "resume_segment_steps",
        "resumed_cumulative_steps",
        "control_steps",
        "accounting",
        "double_charged"
      ],
      "properties": {
        "declared_steps": {
          "type": "integer"
        },
        "source_steps": {
          "type": "integer"
        },
        "resume_segment_steps": {
          "type": "integer"
        },
        "resumed_cumulative_steps": {
          "type": "integer"
        },
        "control_steps": {
          "type": "integer"
        },
        "accounting": {
          "const": "exact"
        },
        "double_charged": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": false
}
