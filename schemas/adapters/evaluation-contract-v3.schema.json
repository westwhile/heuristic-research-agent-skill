{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-contract/v3",
  "title": "EvaluationContract v3",
  "description": "Adapter-layer exchange type derived from one case payload. v3 preserves the v2 study and assessment bindings and adds the case-derived model-selection partition plus the pinned selection and split declarations. A consuming adapter can therefore compare trusted case-side selection facts with result-side final-evaluation facts without copying selection facts into evidence. v1 and v2 remain frozen and registered for their existing producers.",
  "type": "object",
  "required": [
    "schema",
    "case_sha256",
    "study_id",
    "required_evidence",
    "forbidden_channels",
    "checkpoints",
    "assessment_declaration",
    "selection_partition",
    "selection_sha256",
    "split_sha256"
  ],
  "properties": {
    "schema": {
      "const": "evaluation-contract/v3"
    },
    "case_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$"
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_type",
          "min_maturity"
        ],
        "properties": {
          "claim_type": {
            "enum": [
              "engineering_claim",
              "data_claim",
              "mathematical_claim",
              "empirical_claim",
              "predictive_claim",
              "strategy_claim",
              "production_claim"
            ]
          },
          "min_maturity": {
            "enum": [
              "draft",
              "engineering_verified",
              "data_accepted",
              "evaluation_eligible",
              "empirically_supported",
              "mathematically_verified",
              "externally_validated",
              "production_observed"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "forbidden_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "assessment_declaration": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "status"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "status": {
            "enum": [
              "declared",
              "not_performed"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    },
    "selection_partition": {
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "description": "Partition whose metric drove model selection, copied from the hash-bound case by build_evaluation_contract. test remains schema-legal so the consumer-side semantic rejection is falsifiable."
    },
    "selection_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash pin of the case's selection declaration."
    },
    "split_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash pin of the case's split declaration; final experiment evidence must name the same split pin."
    }
  },
  "additionalProperties": false
}
