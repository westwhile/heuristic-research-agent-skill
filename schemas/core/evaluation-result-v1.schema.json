{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-result/v1",
  "title": "EvaluationResult v1",
  "description": "A non-empty score vector for one hash-pinned evaluation attempt. Output, scorer, gates, verdict, and coverage remain single-sourced in the attempt; this record exists only after its one complete output is scored.",
  "type": "object",
  "required": [
    "schema",
    "evaluation_result_id",
    "attempt",
    "score_vector",
    "generated_at"
  ],
  "properties": {
    "schema": {"const": "evaluation-result/v1"},
    "evaluation_result_id": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "attempt": {
      "type": "object",
      "required": ["evaluation_attempt_id", "sha256"],
      "properties": {
        "evaluation_attempt_id": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "score_vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dimension", "value"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
          "value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "additionalProperties": false
      }
    },
    "generated_at": {"type": "string", "x-rfc3339-datetime": true}
  },
  "additionalProperties": false
}
