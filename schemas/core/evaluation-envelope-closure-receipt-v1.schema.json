{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-envelope-closure-receipt/v1",
  "title": "Evaluation Envelope Closure Receipt v1",
  "description": "A receipt binding candidate members and every required evaluation dependency through Core artifact pins. It proves byte or attested-byte closure only, not semantic review, promotion, installation, activation, publication, scientific validity, or external adoption.",
  "type": "object",
  "required": ["schema", "envelope_closure_receipt_id", "candidate", "closed_at", "closure_root_sha256", "members", "topological_order", "exclusions", "required_roles", "artifacts", "receipt_last", "candidate_members_byte_closed", "evaluation_envelope_closed", "hidden_bytes_disclosed", "semantic_review_completed", "limitations"],
  "properties": {
    "schema": {"const": "evaluation-envelope-closure-receipt/v1"},
    "envelope_closure_receipt_id": {"type": "string", "minLength": 33, "maxLength": 33, "pattern": "^envelope-closure-[0-9a-f]{16}$"},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "closed_at": {"type": "string", "minLength": 20, "maxLength": 35, "x-rfc3339-datetime": true},
    "closure_root_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "members": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "role", "sha256", "size_bytes", "depends_on"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 512, "x-safe-relative-path": true},
          "role": {"enum": ["baseline", "patch", "tests", "source_snapshot", "evidence", "other"]},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer"},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 512, "x-safe-relative-path": true}}
        },
        "additionalProperties": false
      }
    },
    "topological_order": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 512, "x-safe-relative-path": true}},
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 512, "x-safe-relative-path": true},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"}
        },
        "additionalProperties": false
      }
    },
    "required_roles": {"const": ["authoritative_head_snapshot", "budget_configuration", "evaluator_configuration", "generator_configuration", "public_data_manifest", "rollback_target", "statistical_plan", "tool_configuration"]},
    "artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["artifact_id", "sha256", "role", "media_type", "content_sha256", "size_bytes", "storage_class", "redaction_state"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
          "role": {"enum": ["authoritative_head_snapshot", "budget_configuration", "evaluator_configuration", "generator_configuration", "public_data_manifest", "rollback_target", "statistical_plan", "tool_configuration"]},
          "media_type": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"},
          "content_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer"},
          "storage_class": {"enum": ["bundle_member", "core_store", "hidden_evaluator"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 512, "x-safe-relative-path": true},
          "redaction_state": {"enum": ["not_required", "redacted", "restricted"]}
        },
        "additionalProperties": false
      }
    },
    "receipt_last": {"const": true},
    "candidate_members_byte_closed": {"const": true},
    "evaluation_envelope_closed": {"const": true},
    "hidden_bytes_disclosed": {"const": false},
    "semantic_review_completed": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S"}}
  },
  "additionalProperties": false
}
